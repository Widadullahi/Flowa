# WhatsApp API Configuration
# Get these from your Meta Business Account
# https://developers.facebook.com/docs/whatsapp/cloud-api

# Your WhatsApp Business Phone ID
# Found in: App Dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_ID=your_phone_id_here

# Your WhatsApp API Access Token
# Found in: App Dashboard → Settings → Tokens
# Must have: whatsapp_business_messaging permission
WHATSAPP_API_TOKEN=your_access_token_here

# Custom webhook verification token (you create this)
# Used to verify webhook requests from Meta
# Can be any random string you choose
WHATSAPP_WEBHOOK_TOKEN=flowa_webhook_secret_123

# Flask Environment
FLASK_ENV=development
DEBUG=True

# API Base URL (for production)
# FLASK_URL=https://your-domain.com

# Master encryption key for encrypting per-business credentials.
# In production, set this to a secure, 32-byte base64 urlsafe string (Fernet key).
# You can generate one locally with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Example: MASTER_KEY=gAAAAABlZ... (do NOT check this into source control)
MASTER_KEY=

