# WhatsApp API Configuration
# Get these from your Meta Business Account
# https://developers.facebook.com/docs/whatsapp/cloud-api

# Your WhatsApp Business Phone ID
WHATSAPP_PHONE_ID=your_phone_id_here

# Your WhatsApp API Access Token
WHATSAPP_API_TOKEN=your_access_token_here

# Custom webhook verification token (you set this when configuring the webhook)
WHATSAPP_WEBHOOK_TOKEN=flowa_webhook_secret_123
